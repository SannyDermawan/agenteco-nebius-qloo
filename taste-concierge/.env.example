# Copy to .env (git-ignored). Names only here, never real values.

# Qloo taste graph (hackathon key from the Qloo team / Devpost resources).
QLOO_API_KEY=
# Default https://api.qloo.com . Set it to the host your key was issued for.
QLOO_BASE_URL=

# Nebius Token Factory (OpenAI-compatible). Default base URL https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
# Optional model ids. When empty the app lists /models and picks the best Nemotron available.
NEBIUS_MODEL_FAST=
NEBIUS_MODEL_REASONING=

# Demo server
PORT=8787
# Set to "sample" to force the labelled sample mode (fixtures, no outside calls).
TASTE_MODE=

# Seller / hire demo only (testnet wallets, never commit)
WALLET_PRIVATE_KEY=
BUYER_PRIVATE_KEY=
AGENTECO_API_URL=
